# URL-ul orchestratorului FastAPI (backend Kage)
ORCHESTRATOR_URL=http://localhost:4001

# Token-ul API al orchestratorului (kage_config.json → api_token).
# E folosit DOAR server-side de proxy-ul /api/agui — nu ajunge niciodată în browser.
KAGE_API_TOKEN=

# Limba interfeței: ro (implicit) sau en. Se citește la build (npm run build).
NEXT_PUBLIC_KAGE_LANG=ro
