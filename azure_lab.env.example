# Lab Azure/Sentinel — copiază în `azure_lab.env` (gitignorat) și completează.
# NU comite fișierul completat: AZURE_CLIENT_SECRET e o parolă.
#
#   set -a; source azure_lab.env; set +a
#   python scripts/ship_risk_audit_to_azure.py --dry-run

AZURE_TENANT_ID=            # Entra ID → app → Overview → Directory (tenant) ID
AZURE_CLIENT_ID=            # Entra ID → app → Overview → Application (client) ID
AZURE_CLIENT_SECRET=        # Certificates & secrets → coloana Value (NU Secret ID)
AZURE_DCE_URI=              # dce-kage-lab → Overview → Logs ingestion
AZURE_DCR_IMMUTABLE_ID=     # dcr-kage-risk → Overview → JSON View → immutableId
AZURE_STREAM_NAME=Custom-KageRisk_CL
